# Public URL of the site. Used for metadata, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://i-doko.ai

# Contact form email, sent through Resend (https://resend.com).
# The from address must be on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional booking embed on /contact. Use a full cal.com or calendly.com URL.
# Leave empty to show the form only.
NEXT_PUBLIC_BOOKING_URL=

# Optional Plausible analytics. Set to the domain registered in Plausible.
# Leave empty to keep analytics off.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
